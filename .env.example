# Salin file ini ke .env lalu isi sesuai environment (lokal/produksi).
# JANGAN commit file .env yang sudah berisi kredensial asli.

; Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zivana_erp
DB_USER=root
DB_PASS=

; Aplikasi
APP_NAME="Zivana ERP"
APP_URL=http://localhost:8000
APP_ENV=local
APP_DEBUG=true
SESSION_LIFETIME=120
; Aktifkan hanya setelah seluruh migrasi dan katalog eRapor baru diverifikasi
ERAPOR_API_ENABLED=false

; Upload
MAX_UPLOAD_SIZE=2097152
ALLOWED_IMAGE_TYPES=jpg,jpeg,png

; Keamanan
CSRF_TOKEN_NAME=csrf_token

; Email (untuk fitur reset password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@zivana-erp.test

# Cloudflare R2 (bucket private untuk PDF rapor terbit)
R2_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PRIVATE_BUCKET=
# Opsional (PHP lokal Windows): path CA bundle, mis. C:/laragon/etc/ssl/cacert.pem
R2_CA_BUNDLE=
